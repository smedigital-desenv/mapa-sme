# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/
# Config compartilhada do Claude Code (.claude/settings.json) é versionada;
# só os arquivos locais ficam de fora.
.claude/settings.local.json
.claude/launch.json
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Dependências (caso use no futuro)
node_modules/

# Arquivos temporários
*.tmp
*.bak

# Dados/dumps NÃO vão ao repositório (evita vazamento de dados pessoais).
# Rode seeds/migrações direto no Supabase. Para versionar schema anonimizado: git add -f arquivo.sql
*.sql
*.csv
*.dump

# Segredos locais (service_role, chaves) — NUNCA no repo.
.env
*.env
!*.env.example

# Dados exportados/gerados da rotina local de devolutivas (dados pessoais).
tools/relatorios/visitas-*.json
tools/relatorios/devolutivas-*.json

# Entradas do tools/conferir-grafias.js (listas de nome de unidade). Não têm
# dado pessoal, mas export não se versiona — a regra da rede vale igual.
tools/grafias-*.txt
tools/catalogo-*.txt
